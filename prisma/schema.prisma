generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
  output        = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  AUXILIAR
  CLIENTE
}

// 1. Catálogo global de módulos
model Module {
  id          String         @id @default(uuid())
  code        String         @unique
  name        String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tenants     TenantModule[]
}

// 2. Control de módulos por cliente
model TenantModule {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, moduleId])
  @@index([tenantId])
  @@index([moduleId])
}

// 3. Empresas registradas en el CRM
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones Administrativas
  users    User[]
  settings Setting[]
  modules  TenantModule[]

  // Relaciones CRM / Tienda
  contacts     Contact[]
  deals        Deal[]
  tasks        Task[]
  contentPosts ContentPost[]
  categories   Category[]    
}

// 4. Usuarios (Staff de la empresa o administradores globales)
model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  phone        String @default("")
  passwordHash String
  role         Role   @default(AUXILIAR)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Interacciones del usuario en el CRM
  deals         Deal[] @relation("UserDeals")
  notes         Note[]
  tasksAssigned Task[] @relation("TaskAssignee")
  blogPosts     BlogPost[] 

  @@index([tenantId])
}

// 5. Configuraciones por negocio
model Setting {
  id    String @id @default(cuid())
  key   String
  value String

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

// ==========================================
// NUEVOS MODELOS CRM
// ==========================================

enum ContactStatus {
  LEAD 
  QUALIFIED 
  CUSTOMER 
  LOST 
}

// 6. Agenda de Contactos / Clientes
model Contact {
  id        String        @id @default(cuid())
  firstName String
  lastName  String?
  email     String?
  phone     String?
  company   String?
  status    ContactStatus @default(LEAD)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals Deal[]
  notes Note[]

  @@index([tenantId])
}

enum DealStage {
  PROSPECTING
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

// 7. Oportunidades / Embudo de Ventas
model Deal {
  id    String    @id @default(cuid())
  title String 
  value Float     @default(0) 
  stage DealStage @default(PROSPECTING)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("UserDeals", fields: [assignedToId], references: [id], onDelete: SetNull)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([contactId])
  @@index([assignedToId])
}

// 8. Notas / Historial de actividad (Llamadas, reuniones, correos)
model Note {
  id      String @id @default(cuid())
  content String @db.Text

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([authorId])
}

// --- NUEVOS ENUMS PARA LAS TAREAS ---
enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

// 9. Tareas de seguimiento (Agenda)
model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  assignedToId String?
  assignedTo   User?       @relation("TaskAssignee", fields: [assignedToId], references: [id])

  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tenantId])
  @@index([assignedToId])
}

// 10. Gestión de contenido
model ContentPost {
  id                 String    @id @default(cuid())
  title              String    
  description        String?
  videoUrl           String    
  platform           String    
  remoteId           String?
  likes              Int       @default(0)
  views              Int       @default(0)
  shares             Int       @default(0)
  cloudinaryPublicId String?
  status             String    @default("DRAFT")
  publishedAt        DateTime?
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ==========================================
// SISTEMA DE BLOG Y TAXONOMÍA UNIFICADA
// ==========================================

// 11. Categorías (Unificadas para Tienda y Blog)
model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Relación con el Blog
  blogPosts   BlogPost[] 
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

// 12. Etiquetas / Tags (Compatible con MySQL)
model Tag {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  
  // Relación de muchos a muchos con los posts
  posts       BlogPost[] 
  
  createdAt   DateTime @default(now())
}

// 13. Entradas de Blog Actualizadas
model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique // URL amigable (ej: mi-primer-articulo)
  excerpt     String?  @db.Text 
  content     String   @db.Text // El contenido completo HTML
  coverImage  String?  // URL de Cloudinary
  status      String   @default("DRAFT") // DRAFT o PUBLISHED
  views       Int      @default(0)
  
  // Relaciones
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Relación con etiquetas (Prisma crea la tabla puente en MySQL automáticamente)
  tags        Tag[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([authorId])
}