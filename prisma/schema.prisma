generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
  output        = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  AUXILIAR
  CLIENTE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

// 1. Nueva tabla para los Clientes/Empresas
model Tenant {
  id        String     @id @default(cuid())
  name      String     // Nombre del negocio
  slug      String     @unique // Para la URL (ej: taller-perez)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relaciones
  users      User[]
  categories Category[]
  products   Product[]
  orders     Order[]
  settings   Setting[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CLIENTE)
  
  // Relación con Tenant (Opcional para permitir la migración inicial)
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]

  @@index([tenantId])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  icon      String
  
  // Relación con Tenant
  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id])
  
  createdAt DateTime  @default(now())
  products  Product[]

  @@index([tenantId])
}

model Product {
  id            String   @id @default(cuid())
  name          String
  description   String   @db.Text
  imageUrl      String   @db.Text // ÚNICA LÍNEA PARA IMÁGENES
  price         Float
  originalPrice Float?
  discount      Int?
  rating        Float    @default(0)
  soldCount     Int      @default(0)
  stock         Int      @default(0)
  isActive      Boolean  @default(true)
  isFlashSale   Boolean  @default(false)
  
  // Relaciones
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([tenantId])
}

model Order {
  id            String      @id @default(cuid())
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  items         Json
  total         Float
  status        OrderStatus @default(PENDING)
  whatsappSent  Boolean     @default(false)
  customerName  String?
  customerPhone String?
  notes         String?     @db.Text

  // Relación con Tenant
  tenantId      String?
  tenant        Tenant?     @relation(fields: [tenantId], references: [id])

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([tenantId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  
  // Las configuraciones también deben ser por cliente
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}