# ============================================
# EcomDash - Variables de entorno
# ============================================
# Copia este archivo como .env y completa los valores
# cp .env.example .env

# --- Base de datos PostgreSQL ---
# Formato: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/NOMBRE_BD
#
# Ejemplo local (Postgres instalado en tu equipo):
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecomdash"
#
# Ejemplo Hostinger (revisa Bases de datos -> PostgreSQL en hPanel):
#   DATABASE_URL="postgresql://u123_user:password@127.0.0.1:5432/u123_ecomdash"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecomdash"

# --- NextAuth ---
# Genera un secreto aleatorio con:  openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-por-un-string-largo-y-aleatorio"

# URL pública de la app. En desarrollo deja localhost.
# En producción debe ser la URL final, ej: https://tutienda.com
NEXTAUTH_URL="http://localhost:3000"
